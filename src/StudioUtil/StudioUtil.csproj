<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="15.0" DefaultTargets="Build">
    <PropertyGroup>
        <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
        <LangVersion>latest</LangVersion>
        <TargetFrameworkProfile />
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x86'">
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x86'">
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
    <!-- WPF's temporary project has a different filename and otherwise loses NuGet source-package paths. -->
    <Import Project="$(MSBuildProjectExtensionsPath)StudioUtil.csproj.nuget.g.props" Condition="$(MSBuildProjectName.EndsWith('_wpftmp')) And Exists('$(MSBuildProjectExtensionsPath)StudioUtil.csproj.nuget.g.props')" />
    <PropertyGroup>
        <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
        <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
        <SchemaVersion>2.0</SchemaVersion>
        <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
        <ProjectGuid>{1C0E61E6-E03E-4D4C-A3D0-EFDA3E7B6A54}</ProjectGuid>
        <OutputType>Library</OutputType>
        <AppDesignerFolder>Properties</AppDesignerFolder>
        <RootNamespace>StudioUtil</RootNamespace>
        <AssemblyName>StudioUtil</AssemblyName>
        <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
        <GeneratePkgDefFile>true</GeneratePkgDefFile>
        <UseCodebase>true</UseCodebase>
        <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
        <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
        <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
        <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
        <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
        <StartAction>Program</StartAction>
        <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
        <VSSDKTargetPlatformRegRootSuffix Condition="'$(VSSDKTargetPlatformRegRootSuffix)' == ''">Exp</VSSDKTargetPlatformRegRootSuffix>
        <StartArguments>/rootsuffix $(VSSDKTargetPlatformRegRootSuffix)</StartArguments>
        <!-- F5 must install the extension in the experimental instance before launching it. -->
        <DeployExtension Condition="'$(DeployExtension)' == '' and '$(Configuration)' == 'Debug'">true</DeployExtension>
        <VsixDeployOnDebug>true</VsixDeployOnDebug>
        <!-- Legacy VSIX deployment is a build target, so F5 must enter MSBuild even when compilation is current. -->
        <DisableFastUpToDateCheck Condition="'$(Configuration)' == 'Debug'">true</DisableFastUpToDateCheck>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <OutputPath>bin\Debug\</OutputPath>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <OutputPath>bin\Release\</OutputPath>
        <DefineConstants>TRACE</DefineConstants>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>4</WarningLevel>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <DefineConstants>$(DefineConstants);NETFRAMEWORK;IS_CORE_MTP;IS_MTP_SERVER_MODE_CLIENT</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="Testing\*.cs" />
        <Compile Include="..\StudioUtil.Contracts\*.cs">
            <Link>Contracts\%(Filename)%(Extension)</Link>
        </Compile>

        <Compile Include="Commands\TestRunnerCommand.cs" />
        <Compile Include="Commands\DownloadFileCommand.cs" />
        <Compile Include="Commands\CreateNewFilesFromClipboardCommand.cs" />
        <Compile Include="Commands\PasteWithReplaceCommand.cs" />
        <Compile Include="Commands\InsertInheritDocCommand.cs" />
        <Compile Include="Commands\SetVariablesCommand.cs" />
        <Compile Include="Commands\CloneAndReplaceCommand.cs" />
        <Compile Include="Const\ProjectGuids.cs" />
        <Compile Include="Dtos\DownloadFileDto.cs" />
        <Compile Include="Dtos\NewItem.cs" />
        <Compile Include="Dtos\ClonePromptDto.cs" />
        <Compile Include="DownloadFileDialog.xaml.cs">
            <DependentUpon>DownloadFileDialog.xaml</DependentUpon>
        </Compile>
        <Compile Include="SetVariablesDialog.xaml.cs">
            <DependentUpon>SetVariablesDialog.xaml</DependentUpon>
        </Compile>
        <Compile Include="CloneAndReplaceDialog.xaml.cs">
            <DependentUpon>CloneAndReplaceDialog.xaml</DependentUpon>
        </Compile>
        <Compile Include="Utils\Abstract\INewItemFactory.cs" />
        <Compile Include="Utils\Abstract\IVariablesUtil.cs" />
        <Compile Include="Utils\NewItemFactory.cs" />
        <Compile Include="Utils\Abstract\IDteUtil.cs" />
        <Compile Include="Utils\Abstract\ISolutionUtil.cs" />
        <Compile Include="Utils\Abstract\IProjectUtil.cs" />
        <Compile Include="Utils\DteUtil.cs" />
        <Compile Include="Utils\CommandFiles.cs" />
        <Compile Include="Properties\AssemblyInfo.cs" />
        <Compile Include="StudioUtilPackage.cs" />
        <Compile Include="source.extension.cs">
            <AutoGen>True</AutoGen>
            <DesignTime>True</DesignTime>
            <DependentUpon>source.extension.vsixmanifest</DependentUpon>
        </Compile>
        <Compile Include="Utils\ProjectHelpers.cs" />
        <Compile Include="Utils\ProjectUtil.cs" />
        <Compile Include="Utils\SolutionUtil.cs" />
        <Compile Include="Utils\VariablesUtil.cs" />
        <Compile Include="Utils\VsTheme.cs" />
        <Compile Include="VSCommandTable.cs">
            <AutoGen>True</AutoGen>
            <DesignTime>True</DesignTime>
            <DependentUpon>VSCommandTable.vsct</DependentUpon>
        </Compile>
    </ItemGroup>

    <ItemGroup>
        <Content Include="..\..\LICENSE">
            <Link>Resources\LICENSE</Link>
            <IncludeInVSIX>true</IncludeInVSIX>
        </Content>
        <None Include="..\..\README.md">
            <Link>README.md</Link>
        </None>
        <None Include="source.extension.vsixmanifest">
            <SubType>Designer</SubType>
            <Generator>VsixManifestGenerator</Generator>
            <LastGenOutput>source.extension.cs</LastGenOutput>
        </None>
    </ItemGroup>

    <ItemGroup>
        <VSCTCompile Include="VSCommandTable.vsct">
            <ResourceName>Menus.ctmenu</ResourceName>
            <Generator>VsctGenerator</Generator>
            <LastGenOutput>VSCommandTable.cs</LastGenOutput>
        </VSCTCompile>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="PresentationCore" />
        <Reference Include="PresentationFramework" />
        <Reference Include="System" />
        <Reference Include="System.Design" />
        <Reference Include="System.ComponentModel.Composition" />
        <Reference Include="System.Windows.Forms" />
        <Reference Include="System.Xaml" />
        <Reference Include="System.Xml" />
        <Reference Include="System.Xml.Linq" />
        <Reference Include="WindowsBase" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Community.VisualStudio.Toolkit.DependencyInjection.Microsoft.17">
            <Version>17.0.27</Version>
        </PackageReference>
        <PackageReference Include="Community.VisualStudio.VSCT" Version="16.0.29.14" PrivateAssets="all" />
        <PackageReference Include="Microsoft.Extensions.Logging">
            <Version>10.0.14</Version>
        </PackageReference>
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48">
            <Version>1.0.3</Version>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.9.820">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" PrivateAssets="all" />
        <PackageReference Include="Nito.AsyncEx">
            <Version>5.1.2</Version>
        </PackageReference>
        <PackageReference Include="Serilog">
            <Version>4.4.0</Version>
        </PackageReference>
        <PackageReference Include="System.Text.Json">
            <Version>10.0.14</Version>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Page Include="Testing\TestRunnerControl.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Include="Testing\TestGutterResources.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Include="Testing\TestRunnerResources.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Include="DownloadFileDialog.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Include="SetVariablesDialog.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
        <Page Include="CloneAndReplaceDialog.xaml">
            <Generator>MSBuild:Compile</Generator>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\icon.png" />
        <Content Include="Resources\logo.png">
            <IncludeInVSIX>true</IncludeInVSIX>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\StudioUtil.Worker\StudioUtil.Worker.csproj">
            <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
            <SkipGetTargetFrameworkProperties>true</SkipGetTargetFrameworkProperties>
            <IncludeInVSIX>false</IncludeInVSIX>
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
    <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
    <!-- These package versions can be newer than the copies bundled with the VS host. -->
    <ItemGroup>
        <SuppressFromVsix Remove="System.Text.Json.dll;System.IO.Pipelines.dll;Microsoft.Bcl.AsyncInterfaces.dll;System.Diagnostics.DiagnosticSource.dll;System.Buffers.dll;System.Memory.dll;System.Runtime.CompilerServices.Unsafe.dll;System.Threading.Tasks.Extensions.dll" />
    </ItemGroup>
    <!-- To modify your build process, add your task inside one of the targets below and uncomment it.
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
    <PropertyGroup>
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>
    <!-- Build the modern worker with dotnet's SDK, not devenv's Framework MSBuild host. -->
    <Target Name="PublishStudioUtilWorker" BeforeTargets="BeforeBuild;GetVsixSourceItems" Condition="'$(DesignTimeBuild)' != 'true' and !$(MSBuildProjectName.EndsWith('_wpftmp'))">
        <PropertyGroup>
            <StudioUtilWorkerOutput>$(MSBuildProjectDirectory)\obj\Worker\$(Configuration)\</StudioUtilWorkerOutput>
        </PropertyGroup>
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\Build-Worker.ps1&quot; -Configuration &quot;$(Configuration)&quot; -OutputDirectory &quot;$(StudioUtilWorkerOutput).&quot;" />
        <ItemGroup>
            <_StudioUtilWorkerFile Include="$(StudioUtilWorkerOutput)**\*" />
            <Content Include="@(_StudioUtilWorkerFile)">
                <Link>Worker\%(_StudioUtilWorkerFile.RecursiveDir)%(_StudioUtilWorkerFile.Filename)%(_StudioUtilWorkerFile.Extension)</Link>
                <VSIXSubPath>Worker\%(_StudioUtilWorkerFile.RecursiveDir)</VSIXSubPath>
                <IncludeInVSIX>true</IncludeInVSIX>
                <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            </Content>
        </ItemGroup>
    </Target>
</Project>
